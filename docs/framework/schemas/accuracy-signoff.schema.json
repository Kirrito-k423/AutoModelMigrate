{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kirrito-k423/AutoModelMigrate/schemas/accuracy-signoff.schema.json",
  "title": "AI Infra Accuracy And Drift Signoff",
  "description": "Versioned accuracy and numerical drift signoff artifact for model migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signoff_id",
    "migration_id",
    "version",
    "baseline",
    "candidate",
    "evaluation",
    "thresholds",
    "drift_policy",
    "results",
    "lifecycle_decision",
    "review",
    "evidence"
  ],
  "properties": {
    "signoff_id": { "type": "string" },
    "migration_id": { "type": "string" },
    "version": { "type": "string" },
    "baseline": { "$ref": "#/$defs/system_ref" },
    "candidate": { "$ref": "#/$defs/system_ref" },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eval_set_id", "version", "scope", "metrics"],
      "properties": {
        "eval_set_id": { "type": "string" },
        "version": { "type": "string" },
        "scope": { "type": "string" },
        "sample_count": { "type": "integer", "minimum": 0 },
        "license_or_usage": { "type": "string" },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } }
      }
    },
    "thresholds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/threshold" }
    },
    "drift_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_policy", "dtype_scope", "backend_scope", "tolerance_notes"],
      "properties": {
        "seed_policy": { "type": "string" },
        "dtype_scope": { "type": "array", "items": { "type": "string" } },
        "backend_scope": { "type": "array", "items": { "type": "string" } },
        "kernel_scope": { "type": "array", "items": { "type": "string" } },
        "tolerance_notes": { "type": "string" }
      }
    },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    },
    "lifecycle_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "blocks_transition", "target_transition"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["pending", "passed", "failed", "blocked", "accepted_risk"]
        },
        "blocks_transition": { "type": "boolean" },
        "target_transition": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "date", "decision"],
      "properties": {
        "reviewer": { "type": "string" },
        "date": { "type": "string" },
        "decision": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "accepted_risk"]
        },
        "notes": { "type": "string" }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_ref" }
    }
  },
  "$defs": {
    "system_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "version_or_revision"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "version_or_revision": { "type": "string" },
        "backend": { "type": "string" },
        "dtype": { "type": "string" },
        "command": { "type": "string" },
        "artifact_hashes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "definition", "owner"],
      "properties": {
        "name": { "type": "string" },
        "definition": { "type": "string" },
        "owner": { "type": "string" }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "comparator",
        "target",
        "tolerance",
        "dtype_scope",
        "backend_scope",
        "blocking"
      ],
      "properties": {
        "metric": { "type": "string" },
        "comparator": { "type": "string" },
        "target": { "type": "number" },
        "tolerance": { "type": "number" },
        "dtype_scope": { "type": "array", "items": { "type": "string" } },
        "backend_scope": { "type": "array", "items": { "type": "string" } },
        "kernel_scope": { "type": "array", "items": { "type": "string" } },
        "blocking": { "type": "boolean" },
        "blocks_transition": { "type": "string" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "status", "blocks_transition"],
      "properties": {
        "metric": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "passed", "failed", "blocked", "accepted_risk"]
        },
        "value": { "type": ["number", "string", "null"] },
        "baseline_value": { "type": ["number", "string", "null"] },
        "candidate_value": { "type": ["number", "string", "null"] },
        "blocks_transition": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence_ref" } }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "uri"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "uri": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
