{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kirrito-k423/AutoModelMigrate/docs/framework/schemas/performance-profile.schema.json",
  "title": "Performance Profile",
  "type": "object",
  "required": [
    "profile_id",
    "version",
    "migration_id",
    "manifest_ref",
    "baseline_id",
    "candidate_id",
    "backend",
    "dtype",
    "hardware",
    "framework_revision",
    "workload",
    "metrics",
    "profiler",
    "bottleneck",
    "regression_guard",
    "status",
    "evidence"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "migration_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_ref": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "dtype": {
      "type": "string",
      "minLength": 1
    },
    "hardware": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "memory_gib": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "interconnect": {
          "type": "string",
          "minLength": 1
        },
        "host_os": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "framework_revision": {
      "type": "object",
      "required": [
        "name",
        "revision"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "recipe_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "workload": {
      "type": "object",
      "required": [
        "slice",
        "modality",
        "declared_batch_shape",
        "actual_batch_shape",
        "declared_context_length",
        "actual_context_length"
      ],
      "properties": {
        "slice": {
          "type": "string",
          "minLength": 1
        },
        "modality": {
          "type": "string",
          "minLength": 1
        },
        "declared_batch_shape": {
          "type": "object",
          "required": [
            "batch_size"
          ],
          "properties": {
            "batch_size": {
              "type": "integer",
              "minimum": 1
            },
            "sequence_length": {
              "type": "integer",
              "minimum": 1
            },
            "context_length": {
              "type": "integer",
              "minimum": 1
            },
            "micro_batch_size": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        },
        "actual_batch_shape": {
          "type": "object",
          "required": [
            "batch_size"
          ],
          "properties": {
            "batch_size": {
              "type": "integer",
              "minimum": 1
            },
            "sequence_length": {
              "type": "integer",
              "minimum": 1
            },
            "context_length": {
              "type": "integer",
              "minimum": 1
            },
            "micro_batch_size": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        },
        "declared_context_length": {
          "type": "integer",
          "minimum": 1
        },
        "actual_context_length": {
          "type": "integer",
          "minimum": 1
        },
        "declared_sequence_length": {
          "type": "integer",
          "minimum": 1
        },
        "actual_sequence_length": {
          "type": "integer",
          "minimum": 1
        },
        "scale_target": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "object",
          "additionalProperties": true
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "required": [
        "common"
      ],
      "properties": {
        "common": {
          "type": "object",
          "required": [
            "throughput",
            "latency",
            "memory",
            "utilization",
            "compile_overhead",
            "runtime_stability"
          ],
          "properties": {
            "throughput": {
              "type": "object",
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": ["number", "null"]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "sample_window_s": {
                  "type": ["number", "null"],
                  "minimum": 0
                }
              },
              "additionalProperties": true
            },
            "latency": {
              "type": "object",
              "required": [
                "unit"
              ],
              "properties": {
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "p50_ms": {
                  "type": ["number", "null"],
                  "minimum": 0
                },
                "p95_ms": {
                  "type": ["number", "null"],
                  "minimum": 0
                },
                "p99_ms": {
                  "type": ["number", "null"],
                  "minimum": 0
                }
              },
              "additionalProperties": true
            },
            "memory": {
              "type": "object",
              "properties": {
                "peak_gib": {
                  "type": ["number", "null"],
                  "minimum": 0
                },
                "activation_gib": {
                  "type": ["number", "null"],
                  "minimum": 0
                },
                "kv_cache_gib": {
                  "type": ["number", "null"],
                  "minimum": 0
                },
                "reserved_gib": {
                  "type": ["number", "null"],
                  "minimum": 0
                }
              },
              "additionalProperties": true
            },
            "utilization": {
              "type": "object",
              "properties": {
                "device_utilization_pct": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 100
                },
                "memory_utilization_pct": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 100
                },
                "compute_utilization_pct": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "additionalProperties": true
            },
            "compile_overhead": {
              "type": "object",
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": ["number", "null"],
                  "minimum": 0
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "warmup_runs": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "cache_hit": {
                  "type": ["boolean", "null"]
                }
              },
              "additionalProperties": true
            },
            "runtime_stability": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "passed",
                    "failed",
                    "blocked"
                  ]
                },
                "duration_min": {
                  "type": ["number", "null"],
                  "minimum": 0
                },
                "incidents": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "notes": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "backend_specific": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "passed",
                  "failed",
                  "blocked"
                ]
              },
              "counters": {
                "type": "object",
                "additionalProperties": {
                  "type": ["number", "string", "boolean", "null"]
                }
              },
              "notes": {
                "type": "string"
              },
              "blockers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "reason",
                    "evidence",
                    "next_action"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "kind",
                          "uri"
                        ],
                        "properties": {
                          "kind": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uri": {
                            "type": "string",
                            "minLength": 1
                          },
                          "note": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "next_action": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "profiler": {
      "type": "object",
      "required": [
        "tool",
        "capture_command",
        "capture_window",
        "artifact_refs"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "capture_command": {
          "type": "string",
          "minLength": 1
        },
        "capture_window": {
          "type": "string",
          "minLength": 1
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "uri"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "bottleneck": {
      "type": "object",
      "required": [
        "hypothesis",
        "observed_evidence",
        "expected_bottleneck"
      ],
      "properties": {
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "observed_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "summary"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "expected_bottleneck": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "regression_guard": {
      "type": "object",
      "required": [
        "correctness_checks",
        "acceptance_thresholds",
        "rerun_criteria"
      ],
      "properties": {
        "correctness_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_thresholds": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "string", "boolean", "null"]
          }
        },
        "rerun_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "blocked"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "uri"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
