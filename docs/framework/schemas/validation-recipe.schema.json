{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kirrito-k423/AutoModelMigrate/schemas/validation-recipe.schema.json",
  "title": "AI Infra Validation Recipe",
  "description": "Reproducible validation recipe for AI model and framework migration gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipe_id",
    "migration_id",
    "version",
    "scope",
    "baseline",
    "candidate",
    "environment",
    "fixtures",
    "gates",
    "results",
    "evidence"
  ],
  "properties": {
    "recipe_id": { "type": "string" },
    "migration_id": { "type": "string" },
    "version": { "type": "string" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "description"],
      "properties": {
        "stage": { "type": "string" },
        "description": { "type": "string" },
        "backend_scope": { "type": "array", "items": { "type": "string" } },
        "non_goals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "baseline": { "$ref": "#/$defs/system_under_test" },
    "candidate": { "$ref": "#/$defs/system_under_test" },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["backend", "dtype", "hardware", "software"],
      "properties": {
        "backend": { "type": "string" },
        "dtype": { "type": "string" },
        "hardware": { "type": "string" },
        "software": { "type": "array", "items": { "type": "string" } },
        "seed_policy": { "type": "string" }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fixture" }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_ref" }
    }
  },
  "$defs": {
    "owner_layer": {
      "type": "string",
      "enum": [
        "ModelSpec",
        "FrameworkAdapter",
        "BackendAdapter",
        "DataAdapter",
        "Recipe",
        "ValidationSuite",
        "OptimizationLoop"
      ]
    },
    "gate_type": {
      "type": "string",
      "enum": [
        "manifest",
        "model_config",
        "tokenizer_processor",
        "checkpoint_metadata",
        "construction_smoke",
        "forward_parity",
        "loss_parity",
        "determinism",
        "backend_runtime",
        "transition"
      ]
    },
    "gate_status": {
      "type": "string",
      "enum": ["pending", "passed", "failed", "blocked", "skipped"]
    },
    "system_under_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "version_or_revision"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "version_or_revision": { "type": "string" },
        "uri": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "modality", "path_or_inline", "expected_evidence"],
      "properties": {
        "id": { "type": "string" },
        "modality": { "type": "string" },
        "path_or_inline": { "type": "string" },
        "expected_evidence": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "owner_layer",
        "blocking",
        "lifecycle_transition",
        "command",
        "expected_evidence",
        "status"
      ],
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/$defs/gate_type" },
        "owner_layer": { "$ref": "#/$defs/owner_layer" },
        "blocking": { "type": "boolean" },
        "lifecycle_transition": { "type": "string" },
        "command": { "type": "string" },
        "fixture_ids": { "type": "array", "items": { "type": "string" } },
        "expected_evidence": { "type": "string" },
        "status": { "$ref": "#/$defs/gate_status" },
        "blocked_by": { "type": "string" },
        "reviewer": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence_ref" } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "blocks_transition"],
      "properties": {
        "gate_id": { "type": "string" },
        "status": { "$ref": "#/$defs/gate_status" },
        "summary": { "type": "string" },
        "blocks_transition": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence_ref" } }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "uri"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "uri": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
